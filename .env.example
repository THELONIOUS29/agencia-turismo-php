AGENCIA_DB_DRIVER=mysql

# MySQL local / XAMPP
AGENCIA_DB_HOST=localhost
AGENCIA_DB_PORT=3306
AGENCIA_DB_NAME=agencia
AGENCIA_DB_SCHEMA=public
AGENCIA_DB_USER=root
AGENCIA_DB_PASSWORD=

# Supabase PostgreSQL
# Cambia AGENCIA_DB_DRIVER a pgsql y copia los datos desde:
# Supabase Dashboard > Project Settings > Database > Connection string.
# Usa el modo "Session pooler" o "Direct connection" con sslmode=require.
# AGENCIA_DB_DRIVER=pgsql
# AGENCIA_DB_HOST=db.TU-PROYECTO.supabase.co
# AGENCIA_DB_PORT=5432
# AGENCIA_DB_NAME=postgres
# AGENCIA_DB_SCHEMA=agencia
# AGENCIA_DB_USER=postgres
# AGENCIA_DB_PASSWORD=TU_PASSWORD

# Opcional: si se deja vacio, registro.php solo valida formato de email.
HUNTER_API_KEY=
